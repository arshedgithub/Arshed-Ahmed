# Netlify (static export): serve one canonical host. Cloudflare Pages ignores domain rules here;
# use a Cloudflare Bulk Redirect instead (see README).
https://www.arshedahmed.com/* https://arshedahmed.com/:splat 301!
# Arabic 404 for unmatched /ar/* URLs (Netlify; Cloudflare Pages finds the nearest 404.html by itself).
/ar/* /ar/404.html 404
