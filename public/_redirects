# Netlify (static export): serve one canonical host, www (SITE_URL in src/lib/site.ts). Cloudflare Pages ignores
# domain rules here; use a Cloudflare Bulk Redirect instead (see README, "Canonical host").
https://arshedahmed.com/* https://www.arshedahmed.com/:splat 301!
# Arabic 404 for unmatched /ar/* URLs (Netlify; Cloudflare Pages finds the nearest 404.html by itself).
/ar/* /ar/404.html 404
